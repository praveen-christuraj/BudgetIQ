# ---------------------------------------------------------------------------
# Family Finance Manager - environment configuration
# Copy this file to `.env` and adjust values before starting Docker Compose.
# Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# Application
APP_NAME=Family Finance Manager
ENVIRONMENT=production
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Database (PostgreSQL - internal Docker network only)
POSTGRES_DB=family_finance
POSTGRES_USER=family_finance
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://family_finance:change-me-to-a-strong-password@db:5432/family_finance

# Uploads / attachments
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10

# Backups (the `backup` compose service runs pg_dump on this schedule)
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
# Optional: encrypt each pg_dump with `gpg --symmetric` using this passphrase
BACKUP_ENCRYPTION_PASSPHRASE=

# Runtime tuning
UVICORN_WORKERS=2

# Frontend (build-time, optional; relative /api is the default)
VITE_API_BASE_URL=/api/v1

# Ports exposed on the home network
FRONTEND_PORT=8080
BACKEND_PORT=8000
